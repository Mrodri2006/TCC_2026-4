rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/Usuario/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.admin == true
          || get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.tipo == 'admin'
        );
    }

    function activePrestador(uid) {
      return exists(/databases/$(database)/documents/Usuario/$(uid))
        && get(/databases/$(database)/documents/Usuario/$(uid)).data.tipo == 'prestador'
        && get(/databases/$(database)/documents/Usuario/$(uid)).data.contaAtiva == true
        && get(/databases/$(database)/documents/Usuario/$(uid)).data.assinaturaAtiva != false;
    }

    function touchesBillingFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'assinaturaAtiva',
        'contaAtiva',
        'dataCadastro',
        'dataVencimento',
        'ultimoPagamento',
        'statusPagamento',
        'valorMensalidade',
        'bloqueadoEm',
        'motivoBloqueio'
      ]);
    }

    function touchesReviewFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'avaliacaoNota', 'avaliacaoComentario', 'avaliacaoData', 'avaliacaoLiberada',
        'avaliado', 'avaliacaoSoma', 'numeroAvaliacoes', 'avaliacao'
      ]);
    }

    function validReviewUpdate() {
      return signedIn()
        && resource.data.clienteId == request.auth.uid
        && resource.data.status == 'realizado'
        && resource.data.get('avaliado', false) == false
        && request.resource.data.avaliado == true
        && request.resource.data.avaliacaoNota is number
        && request.resource.data.avaliacaoNota >= 1
        && request.resource.data.avaliacaoNota <= 5
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'avaliacaoNota', 'avaliacaoComentario', 'avaliacaoData', 'avaliacaoLiberada', 'avaliado'
        ]);
    }

    function participantIn(data) {
      return signedIn()
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    function areaParticipant(data) {
      return signedIn()
        && data.prestadoresIds is list
        && request.auth.uid in data.prestadoresIds;
    }

    match /Usuario/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.tipo in ['prestador', 'contratante']
        && (
          !request.resource.data.keys().hasAny(['admin'])
          || request.resource.data.admin == false
        )
        && (
          request.resource.data.tipo == 'contratante'
          || (
            request.resource.data.assinaturaAtiva == false
            && request.resource.data.contaAtiva == false
            && request.resource.data.statusPagamento == 'primeiro_pagamento_pendente'
          )
        );

      allow read: if isOwner(uid)
        || isAdmin()
        || (
          resource.data.tipo == 'prestador'
          && resource.data.contaAtiva == true
          && resource.data.assinaturaAtiva != false
        )
        || (signedIn() && resource.data.tipo == 'contratante');

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && !touchesBillingFields()
          && !touchesReviewFields()
          && !request.resource.data.diff(resource.data).changedKeys().hasAny(['admin', 'tipo'])
        );

      allow delete: if isOwner(uid) || isAdmin();

      match /Mensalidades/{periodKey} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /Notificacoes/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (
            isOwner(uid)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lida'])
          );
      }

      match /PushTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /Disponibilidade/{diaId} {
        allow read: if isOwner(uid) || isAdmin() || (signedIn() && activePrestador(uid));
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /Indisponibilidades/{periodoId} {
        allow read: if isOwner(uid) || isAdmin() || (signedIn() && activePrestador(uid));
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /ReservasAgenda/{reservaId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /Bloqueados/{blockedId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /Favoritos/{providerId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.auth.uid != providerId
          && request.resource.data.providerId == providerId;
      }

      match /Serv/{servId} {
        allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /Posts/{postId} {
        allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      match /Avaliacoes/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && reviewId == request.resource.data.servicoId
          && request.resource.data.prestadorId == uid
          && request.resource.data.avaliacaoNota is number
          && request.resource.data.avaliacaoNota >= 1
          && request.resource.data.avaliacaoNota <= 5
          && request.resource.data.keys().hasOnly(['servicoId', 'clienteId', 'prestadorId', 'avaliacaoNota', 'avaliacaoComentario', 'avaliacaoData'])
          && (
            (
              request.resource.data.clienteId == request.auth.uid
              && exists(/databases/$(database)/documents/ServicosClientes/$(request.auth.uid)/ServicoStatus/$(reviewId))
              && get(/databases/$(database)/documents/ServicosClientes/$(request.auth.uid)/ServicoStatus/$(reviewId)).data.prestadorId == uid
              && get(/databases/$(database)/documents/ServicosClientes/$(request.auth.uid)/ServicoStatus/$(reviewId)).data.status == 'realizado'
            )
            || (
              isOwner(uid)
              && exists(/databases/$(database)/documents/ServicosAgendados/$(uid)/ServicoStatus/$(reviewId))
              && get(/databases/$(database)/documents/ServicosAgendados/$(uid)/ServicoStatus/$(reviewId)).data.avaliado == true
              && get(/databases/$(database)/documents/ServicosAgendados/$(uid)/ServicoStatus/$(reviewId)).data.clienteId == request.resource.data.clienteId
              && get(/databases/$(database)/documents/ServicosAgendados/$(uid)/ServicoStatus/$(reviewId)).data.avaliacaoNota == request.resource.data.avaliacaoNota
            )
          );
        allow update, delete: if false;
      }
    }

    match /ServicosAdds/{uid}/ServicosOferecidos/{servicoId} {
      allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());
      allow create, update, delete: if isOwner(uid) || isAdmin();
    }

    match /ServicosAgendados/{prestadorId}/ServicoStatus/{servicoId} {
      allow read: if isAdmin()
        || isOwner(prestadorId)
        || (signedIn() && resource.data.clienteId == request.auth.uid);

      allow create: if isAdmin()
        || isOwner(prestadorId)
        || (signedIn() && request.resource.data.clienteId == request.auth.uid);

      allow update: if isAdmin()
        || validReviewUpdate()
        || (
          !touchesReviewFields()
          && (
            isOwner(prestadorId)
            || (signedIn() && resource.data.clienteId == request.auth.uid)
            || (signedIn() && request.resource.data.clienteId == request.auth.uid)
          )
        );

      allow delete: if isAdmin()
        || isOwner(prestadorId)
        || (signedIn() && resource.data.clienteId == request.auth.uid);

      match /Propostas/{propostaId} {
        allow read: if isAdmin() || isOwner(prestadorId)
          || (signedIn() && get(/databases/$(database)/documents/ServicosAgendados/$(prestadorId)/ServicoStatus/$(servicoId)).data.clienteId == request.auth.uid);
        allow write: if false;
      }

    }

    match /ServicosClientes/{clienteId}/ServicoStatus/{servicoId} {
      allow read: if isAdmin()
        || isOwner(clienteId)
        || (signedIn() && resource.data.clienteId == request.auth.uid)
        || (signedIn() && resource.data.prestadorId == request.auth.uid);

      allow create: if isAdmin()
        || isOwner(clienteId)
        || (signedIn() && request.resource.data.prestadorId == request.auth.uid);

      allow update: if isAdmin()
        || validReviewUpdate()
        || (
          !touchesReviewFields()
          && (
            isOwner(clienteId)
            || (signedIn() && resource.data.prestadorId == request.auth.uid)
            || (signedIn() && request.resource.data.prestadorId == request.auth.uid)
          )
        );

      allow delete: if isAdmin()
        || isOwner(clienteId)
        || (signedIn() && resource.data.prestadorId == request.auth.uid);

      match /Propostas/{propostaId} {
        allow read: if isAdmin() || isOwner(clienteId)
          || (signedIn() && get(/databases/$(database)/documents/ServicosClientes/$(clienteId)/ServicoStatus/$(servicoId)).data.prestadorId == request.auth.uid);
        allow write: if false;
      }
    }

    match /ServicosRejeitados/{prestadorId}/ServicoStatus/{servicoId} {
      allow read, create, update, delete: if isOwner(prestadorId) || isAdmin();
    }

    match /SolicitacoesArea/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.clienteId == request.auth.uid)
        || areaParticipant(resource.data);

      allow create: if signedIn() && request.resource.data.clienteId == request.auth.uid;

      allow update: if isAdmin()
        || (signedIn() && resource.data.clienteId == request.auth.uid)
        || areaParticipant(resource.data);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.clienteId == request.auth.uid);
    }

    match /SolicitacoesMensalidade/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente';

      allow update, delete: if isAdmin();
    }

    function isContratante() {
      return signedIn()
        && exists(/databases/$(database)/documents/Usuario/$(request.auth.uid))
        && get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.tipo == 'contratante';
    }

    match /ProblemasServicos/{problemaId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.clienteId == request.auth.uid)
        || (signedIn() && resource.data.prestadorId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.relatorId == request.auth.uid
        && (
          request.resource.data.clienteId == request.auth.uid
          || request.resource.data.prestadorId == request.auth.uid
        )
        && request.resource.data.status == 'pendente';

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.relatorId == request.auth.uid
          && request.resource.data.relatorId == resource.data.relatorId
          && request.resource.data.clienteId == resource.data.clienteId
          && request.resource.data.prestadorId == resource.data.prestadorId
          && request.resource.data.status == 'pendente'
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['descricao', 'criadoEm'])
        );
      allow delete: if isAdmin();
    }

    match /LocalizacoesPrestadores/{prestadorId} {
      allow get: if isOwner(prestadorId)
        || isAdmin()
        || (
          isContratante()
          && activePrestador(prestadorId)
          && resource.data.expiresAt > request.time
        );

      // A validade e o perfil ativo são filtrados novamente pelo aplicativo.
      // Separar list de get evita que o Firestore rejeite a consulta inteira
      // por não conseguir comparar o horário do cliente com request.time.
      allow list: if isAdmin() || isContratante();

      allow create, update: if isOwner(prestadorId)
        && activePrestador(prestadorId)
        && request.resource.data.prestadorId == prestadorId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'h')
        && request.resource.data.keys().hasOnly([
          'prestadorId', 'latitude', 'longitude', 'accuracy', 'updatedAt', 'expiresAt'
        ]);

      allow delete: if isOwner(prestadorId) || isAdmin();
    }

    match /Denuncias/{denunciaId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pendente';
      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /Chats/{chatId} {
      allow read, delete: if participantIn(resource.data) || isAdmin();
      allow create: if isAdmin()
        || (
          participantIn(request.resource.data)
          && request.resource.data.participants.size() == 2
          && request.resource.data.keys().hasOnly([
            'participants', 'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadFor'
          ])
        );
      allow update: if isAdmin()
        || (
          participantIn(resource.data)
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadFor'
          ])
        );

      match /Messages/{messageId} {
        allow read: if isAdmin()
          || participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'replyTo', 'readBy', 'attachment', 'location'])
          && participantIn(getAfter(/databases/$(database)/documents/Chats/$(chatId)).data);
        allow update, delete: if false;
      }

      match /Presence/{presenceUid} {
        allow read: if isAdmin()
          || participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);
        allow create, update, delete: if signedIn()
          && request.auth.uid == presenceUid
          && participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);
      }
    }

    match /MercadoPagoWebhooks/{webhookId} {
      allow read, write: if false;
    }

    match /AuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /PublicConfig/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /RateLimits/{limitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

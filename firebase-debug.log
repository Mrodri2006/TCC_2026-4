[debug] [2026-06-22T13:53:44.402Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/info-650fe/rulesets {"name":"projects/info-650fe/rulesets/048bcdae-5fd7-4fea-823f-1fac0b402dfb","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(uid) {\r\n      return signedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/Usuario/$(request.auth.uid))\r\n        && (\r\n          get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.admin == true\r\n          || get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.tipo == 'admin'\r\n        );\r\n    }\r\n\r\n    function activePrestador(uid) {\r\n      return exists(/databases/$(database)/documents/Usuario/$(uid))\r\n        && get(/databases/$(database)/documents/Usuario/$(uid)).data.tipo == 'prestador'\r\n        && get(/databases/$(database)/documents/Usuario/$(uid)).data.contaAtiva == true\r\n        && get(/databases/$(database)/documents/Usuario/$(uid)).data.assinaturaAtiva != false;\r\n    }\r\n\r\n    function touchesBillingFields() {\r\n      return request.resource.data.diff(resource.data).changedKeys().hasAny([\r\n        'assinaturaAtiva',\r\n        'contaAtiva',\r\n        'dataCadastro',\r\n        'dataVencimento',\r\n        'ultimoPagamento',\r\n        'statusPagamento',\r\n        'valorMensalidade',\r\n        'bloqueadoEm',\r\n        'motivoBloqueio'\r\n      ]);\r\n    }\r\n\r\n    function participantIn(data) {\r\n      return signedIn()\r\n        && data.participants is list\r\n        && request.auth.uid in data.participants;\r\n    }\r\n\r\n    function areaParticipant(data) {\r\n      return signedIn()\r\n        && data.prestadoresIds is list\r\n        && request.auth.uid in data.prestadoresIds;\r\n    }\r\n\r\n    match /Usuario/{uid} {\r\n      allow create: if isOwner(uid)\r\n        && request.resource.data.tipo in ['prestador', 'contratante']\r\n        && (\r\n          !request.resource.data.keys().hasAny(['admin'])\r\n          || request.resource.data.admin == false\r\n        );\r\n\r\n      allow read: if isOwner(uid)\r\n        || isAdmin()\r\n        || (\r\n          resource.data.tipo == 'prestador'\r\n          && resource.data.contaAtiva == true\r\n          && resource.data.assinaturaAtiva != false\r\n        )\r\n        || (signedIn() && resource.data.tipo == 'contratante');\r\n\r\n      allow update: if isAdmin()\r\n        || (\r\n          isOwner(uid)\r\n          && !touchesBillingFields()\r\n          && !request.resource.data.diff(resource.data).changedKeys().hasAny(['admin', 'tipo'])\r\n        );\r\n\r\n      allow delete: if isOwner(uid) || isAdmin();\r\n\r\n      match /Mensalidades/{periodKey} {\r\n        allow read: if isOwner(uid) || isAdmin();\r\n        allow create, update, delete: if false;\r\n      }\r\n\r\n      match /Notificacoes/{notifId} {\r\n        allow read: if isOwner(uid) || isAdmin();\r\n        allow create, delete: if isAdmin();\r\n        allow update: if isAdmin()\r\n          || (\r\n            isOwner(uid)\r\n            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lida'])\r\n          );\r\n      }\r\n\r\n      match /Serv/{servId} {\r\n        allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());\r\n        allow create, update, delete: if isOwner(uid) || isAdmin();\r\n      }\r\n\r\n      match /Posts/{postId} {\r\n        allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());\r\n        allow create, update, delete: if isOwner(uid) || isAdmin();\r\n      }\r\n    }\r\n\r\n    match /ServicosAdds/{uid}/ServicosOferecidos/{servicoId} {\r\n      allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());\r\n      allow create, update, delete: if isOwner(uid) || isAdmin();\r\n    }\r\n\r\n    match /ServicosAgendados/{prestadorId}/ServicoStatus/{servicoId} {\r\n      allow read: if isAdmin()\r\n        || isOwner(prestadorId)\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid);\r\n\r\n      allow create: if isAdmin()\r\n        || isOwner(prestadorId)\r\n        || (signedIn() && request.resource.data.clienteId == request.auth.uid);\r\n\r\n      allow update: if isAdmin()\r\n        || isOwner(prestadorId)\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || (signedIn() && request.resource.data.clienteId == request.auth.uid);\r\n\r\n      allow delete: if isAdmin()\r\n        || isOwner(prestadorId)\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid);\r\n    }\r\n\r\n    match /ServicosClientes/{clienteId}/ServicoStatus/{servicoId} {\r\n      allow read: if isAdmin()\r\n        || isOwner(clienteId)\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || (signedIn() && resource.data.prestadorId == request.auth.uid);\r\n\r\n      allow create: if isAdmin()\r\n        || isOwner(clienteId)\r\n        || (signedIn() && request.resource.data.prestadorId == request.auth.uid);\r\n\r\n      allow update: if isAdmin()\r\n        || isOwner(clienteId)\r\n        || (signedIn() && resource.data.prestadorId == request.auth.uid)\r\n        || (signedIn() && request.resource.data.prestadorId == request.auth.uid);\r\n\r\n      allow delete: if isAdmin()\r\n        || isOwner(clienteId)\r\n        || (signedIn() && resource.data.prestadorId == request.auth.uid);\r\n    }\r\n\r\n    match /ServicosRejeitados/{prestadorId}/ServicoStatus/{servicoId} {\r\n      allow read, create, update, delete: if isOwner(prestadorId) || isAdmin();\r\n    }\r\n\r\n    match /SolicitacoesArea/{requestId} {\r\n      allow read: if isAdmin()\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || areaParticipant(resource.data);\r\n\r\n      allow create: if signedIn() && request.resource.data.clienteId == request.auth.uid;\r\n\r\n      allow update: if isAdmin()\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || areaParticipant(resource.data);\r\n\r\n      allow delete: if isAdmin()\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid);\r\n    }\r\n\r\n    match /SolicitacoesMensalidade/{requestId} {\n      allow read: if isAdmin()\r\n        || (signedIn() && resource.data.uid == request.auth.uid);\r\n\r\n      allow create: if signedIn()\r\n        && request.resource.data.uid == request.auth.uid\r\n        && request.resource.data.status == 'pendente';\r\n\r\n      allow update, delete: if isAdmin();\n    }\n\n    match /ProblemasServicos/{problemaId} {\n      allow read: if isAdmin()\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\n        || (signedIn() && resource.data.prestadorId == request.auth.uid);\n\n      allow create: if signedIn()\n        && request.resource.data.relatorId == request.auth.uid\n        && (\n          request.resource.data.clienteId == request.auth.uid\n          || request.resource.data.prestadorId == request.auth.uid\n        )\n        && request.resource.data.status == 'pendente';\n\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && resource.data.relatorId == request.auth.uid\n          && request.resource.data.relatorId == resource.data.relatorId\n          && request.resource.data.clienteId == resource.data.clienteId\n          && request.resource.data.prestadorId == resource.data.prestadorId\n          && request.resource.data.status == 'pendente'\n          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['descricao', 'criadoEm'])\n        );\n      allow delete: if isAdmin();\n    }\n\r\n    match /Chats/{chatId} {\r\n      allow read, update, delete: if participantIn(resource.data) || isAdmin();\r\n      allow create: if participantIn(request.resource.data) || isAdmin();\r\n\r\n      match /Messages/{messageId} {\r\n        allow read: if isAdmin()\r\n          || participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);\r\n\r\n        allow create: if signedIn()\r\n          && request.resource.data.senderId == request.auth.uid\r\n          && (\r\n            isAdmin()\r\n            || participantIn(getAfter(/databases/$(database)/documents/Chats/$(chatId)).data)\r\n          );\r\n\r\n        allow update, delete: if false;\r\n      }\r\n    }\r\n\r\n    match /MercadoPagoWebhooks/{webhookId} {\r\n      allow read, write: if false;\r\n    }\r\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-06-22T13:53:44.297775Z","metadata":{"services":["cloud.firestore"]}}

[debug] [2026-07-04T17:51:58.167Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/info-650fe/rulesets {"name":"projects/info-650fe/rulesets/10315635-dadc-42fb-8b84-a2c945d05d7c","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isOwner(uid) {\r\n      return signedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    function isAdmin() {\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/Usuario/$(request.auth.uid))\r\n        && (\r\n          get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.admin == true\r\n          || get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.tipo == 'admin'\r\n        );\r\n    }\r\n\r\n    function activePrestador(uid) {\r\n      return exists(/databases/$(database)/documents/Usuario/$(uid))\r\n        && get(/databases/$(database)/documents/Usuario/$(uid)).data.tipo == 'prestador'\r\n        && get(/databases/$(database)/documents/Usuario/$(uid)).data.contaAtiva == true\r\n        && get(/databases/$(database)/documents/Usuario/$(uid)).data.assinaturaAtiva != false;\r\n    }\r\n\r\n    function touchesBillingFields() {\n      return request.resource.data.diff(resource.data).changedKeys().hasAny([\r\n        'assinaturaAtiva',\r\n        'contaAtiva',\r\n        'dataCadastro',\r\n        'dataVencimento',\r\n        'ultimoPagamento',\r\n        'statusPagamento',\r\n        'valorMensalidade',\r\n        'bloqueadoEm',\r\n        'motivoBloqueio'\r\n      ]);\n    }\n\n    function touchesReviewFields() {\n      return request.resource.data.diff(resource.data).changedKeys().hasAny([\n        'avaliacaoNota', 'avaliacaoComentario', 'avaliacaoData', 'avaliacaoLiberada',\n        'avaliado', 'avaliacaoSoma', 'numeroAvaliacoes', 'avaliacao'\n      ]);\n    }\n\n    function validReviewUpdate() {\n      return signedIn()\n        && resource.data.clienteId == request.auth.uid\n        && resource.data.status == 'realizado'\n        && resource.data.get('avaliado', false) == false\n        && request.resource.data.avaliado == true\n        && request.resource.data.avaliacaoNota is number\n        && request.resource.data.avaliacaoNota >= 1\n        && request.resource.data.avaliacaoNota <= 5\n        && request.resource.data.diff(resource.data).changedKeys().hasOnly([\n          'avaliacaoNota', 'avaliacaoComentario', 'avaliacaoData', 'avaliacaoLiberada', 'avaliado'\n        ]);\n    }\n\r\n    function participantIn(data) {\r\n      return signedIn()\r\n        && data.participants is list\r\n        && request.auth.uid in data.participants;\r\n    }\r\n\r\n    function areaParticipant(data) {\r\n      return signedIn()\r\n        && data.prestadoresIds is list\r\n        && request.auth.uid in data.prestadoresIds;\r\n    }\r\n\r\n    match /Usuario/{uid} {\r\n      allow create: if isOwner(uid)\n        && request.resource.data.tipo in ['prestador', 'contratante']\n        && (\n          !request.resource.data.keys().hasAny(['admin'])\n          || request.resource.data.admin == false\n        )\n        && (\n          request.resource.data.tipo == 'contratante'\n          || (\n            request.resource.data.assinaturaAtiva == false\n            && request.resource.data.contaAtiva == false\n            && request.resource.data.statusPagamento == 'primeiro_pagamento_pendente'\n          )\n        );\n\r\n      allow read: if isOwner(uid)\r\n        || isAdmin()\r\n        || (\r\n          resource.data.tipo == 'prestador'\r\n          && resource.data.contaAtiva == true\r\n          && resource.data.assinaturaAtiva != false\r\n        )\r\n        || (signedIn() && resource.data.tipo == 'contratante');\r\n\r\n      allow update: if isAdmin()\r\n        || (\r\n          isOwner(uid)\r\n          && !touchesBillingFields()\n          && !touchesReviewFields()\n          && !request.resource.data.diff(resource.data).changedKeys().hasAny(['admin', 'tipo'])\r\n        );\r\n\r\n      allow delete: if isOwner(uid) || isAdmin();\r\n\r\n      match /Mensalidades/{periodKey} {\r\n        allow read: if isOwner(uid) || isAdmin();\r\n        allow create, update, delete: if false;\r\n      }\r\n\r\n      match /Notificacoes/{notifId} {\n        allow read: if isOwner(uid) || isAdmin();\r\n        allow create, delete: if isAdmin();\r\n        allow update: if isAdmin()\r\n          || (\r\n            isOwner(uid)\r\n            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lida'])\r\n          );\r\n      }\n\n      match /PushTokens/{tokenId} {\n        allow read, create, update, delete: if isOwner(uid);\n      }\n\n      match /Disponibilidade/{diaId} {\n        allow read: if isOwner(uid) || isAdmin() || (signedIn() && activePrestador(uid));\n        allow create, update, delete: if isOwner(uid) || isAdmin();\n      }\n\n      match /Indisponibilidades/{periodoId} {\n        allow read: if isOwner(uid) || isAdmin() || (signedIn() && activePrestador(uid));\n        allow create, update, delete: if isOwner(uid) || isAdmin();\n      }\n\n      match /ReservasAgenda/{reservaId} {\n        allow read: if isOwner(uid) || isAdmin();\n        allow create, update, delete: if false;\n      }\n\n      match /Bloqueados/{blockedId} {\n        allow read, create, update, delete: if isOwner(uid);\n      }\n\n      match /Favoritos/{providerId} {\n        allow read, delete: if isOwner(uid);\n        allow create, update: if isOwner(uid)\n          && request.auth.uid != providerId\n          && request.resource.data.providerId == providerId;\n      }\n\r\n      match /Serv/{servId} {\r\n        allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());\r\n        allow create, update, delete: if isOwner(uid) || isAdmin();\r\n      }\r\n\r\n      match /Posts/{postId} {\r\n        allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());\r\n        allow create, update, delete: if isOwner(uid) || isAdmin();\r\n      }\r\n    }\r\n\r\n    match /ServicosAdds/{uid}/ServicosOferecidos/{servicoId} {\r\n      allow read: if signedIn() && (isOwner(uid) || activePrestador(uid) || isAdmin());\r\n      allow create, update, delete: if isOwner(uid) || isAdmin();\r\n    }\r\n\r\n    match /ServicosAgendados/{prestadorId}/ServicoStatus/{servicoId} {\n      allow read: if isAdmin()\r\n        || isOwner(prestadorId)\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid);\r\n\r\n      allow create: if isAdmin()\r\n        || isOwner(prestadorId)\r\n        || (signedIn() && request.resource.data.clienteId == request.auth.uid);\r\n\r\n      allow update: if isAdmin()\n        || validReviewUpdate()\n        || (\n          !touchesReviewFields()\n          && (\n            isOwner(prestadorId)\n            || (signedIn() && resource.data.clienteId == request.auth.uid)\n            || (signedIn() && request.resource.data.clienteId == request.auth.uid)\n          )\n        );\n\r\n      allow delete: if isAdmin()\n        || isOwner(prestadorId)\n        || (signedIn() && resource.data.clienteId == request.auth.uid);\n\n      match /Propostas/{propostaId} {\n        allow read: if isAdmin() || isOwner(prestadorId)\n          || (signedIn() && get(/databases/$(database)/documents/ServicosAgendados/$(prestadorId)/ServicoStatus/$(servicoId)).data.clienteId == request.auth.uid);\n        allow write: if false;\n      }\n    }\n\r\n    match /ServicosClientes/{clienteId}/ServicoStatus/{servicoId} {\n      allow read: if isAdmin()\r\n        || isOwner(clienteId)\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || (signedIn() && resource.data.prestadorId == request.auth.uid);\r\n\r\n      allow create: if isAdmin()\r\n        || isOwner(clienteId)\r\n        || (signedIn() && request.resource.data.prestadorId == request.auth.uid);\r\n\r\n      allow update: if isAdmin()\n        || validReviewUpdate()\n        || (\n          !touchesReviewFields()\n          && (\n            isOwner(clienteId)\n            || (signedIn() && resource.data.prestadorId == request.auth.uid)\n            || (signedIn() && request.resource.data.prestadorId == request.auth.uid)\n          )\n        );\n\r\n      allow delete: if isAdmin()\n        || isOwner(clienteId)\n        || (signedIn() && resource.data.prestadorId == request.auth.uid);\n\n      match /Propostas/{propostaId} {\n        allow read: if isAdmin() || isOwner(clienteId)\n          || (signedIn() && get(/databases/$(database)/documents/ServicosClientes/$(clienteId)/ServicoStatus/$(servicoId)).data.prestadorId == request.auth.uid);\n        allow write: if false;\n      }\n    }\n\r\n    match /ServicosRejeitados/{prestadorId}/ServicoStatus/{servicoId} {\r\n      allow read, create, update, delete: if isOwner(prestadorId) || isAdmin();\r\n    }\r\n\r\n    match /SolicitacoesArea/{requestId} {\r\n      allow read: if isAdmin()\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || areaParticipant(resource.data);\r\n\r\n      allow create: if signedIn() && request.resource.data.clienteId == request.auth.uid;\r\n\r\n      allow update: if isAdmin()\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\r\n        || areaParticipant(resource.data);\r\n\r\n      allow delete: if isAdmin()\r\n        || (signedIn() && resource.data.clienteId == request.auth.uid);\r\n    }\r\n\r\n    match /SolicitacoesMensalidade/{requestId} {\n      allow read: if isAdmin()\r\n        || (signedIn() && resource.data.uid == request.auth.uid);\r\n\r\n      allow create: if signedIn()\r\n        && request.resource.data.uid == request.auth.uid\r\n        && request.resource.data.status == 'pendente';\r\n\r\n      allow update, delete: if isAdmin();\n    }\n\n    function isContratante() {\n      return signedIn()\n        && exists(/databases/$(database)/documents/Usuario/$(request.auth.uid))\n        && get(/databases/$(database)/documents/Usuario/$(request.auth.uid)).data.tipo == 'contratante';\n    }\n\n    match /ProblemasServicos/{problemaId} {\n      allow read: if isAdmin()\n        || (signedIn() && resource.data.clienteId == request.auth.uid)\n        || (signedIn() && resource.data.prestadorId == request.auth.uid);\n\n      allow create: if signedIn()\n        && request.resource.data.relatorId == request.auth.uid\n        && (\n          request.resource.data.clienteId == request.auth.uid\n          || request.resource.data.prestadorId == request.auth.uid\n        )\n        && request.resource.data.status == 'pendente';\n\n      allow update: if isAdmin()\n        || (\n          signedIn()\n          && resource.data.relatorId == request.auth.uid\n          && request.resource.data.relatorId == resource.data.relatorId\n          && request.resource.data.clienteId == resource.data.clienteId\n          && request.resource.data.prestadorId == resource.data.prestadorId\n          && request.resource.data.status == 'pendente'\n          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['descricao', 'criadoEm'])\n        );\n      allow delete: if isAdmin();\n    }\n\n    match /LocalizacoesPrestadores/{prestadorId} {\n      allow read: if isOwner(prestadorId)\n        || isAdmin()\n        || (\n          isContratante()\n          && activePrestador(prestadorId)\n          && resource.data.expiresAt > request.time\n        );\n\n      allow create, update: if isOwner(prestadorId)\n        && activePrestador(prestadorId)\n        && request.resource.data.prestadorId == prestadorId\n        && request.resource.data.latitude is number\n        && request.resource.data.latitude >= -90\n        && request.resource.data.latitude <= 90\n        && request.resource.data.longitude is number\n        && request.resource.data.longitude >= -180\n        && request.resource.data.longitude <= 180\n        && request.resource.data.expiresAt is timestamp\n        && request.resource.data.expiresAt > request.time\n        && request.resource.data.expiresAt <= request.time + duration.value(3, 'h')\n        && request.resource.data.keys().hasOnly([\n          'prestadorId', 'latitude', 'longitude', 'accuracy', 'updatedAt', 'expiresAt'\n        ]);\n\n      allow delete: if isOwner(prestadorId) || isAdmin();\n    }\n\n    match /Denuncias/{denunciaId} {\n      allow create: if signedIn()\n        && request.resource.data.reporterId == request.auth.uid\n        && request.resource.data.status == 'pendente';\n      allow read: if isAdmin() || (signedIn() && resource.data.reporterId == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n\n    match /Chats/{chatId} {\n      allow read, delete: if participantIn(resource.data) || isAdmin();\n      allow create: if isAdmin()\n        || (\n          participantIn(request.resource.data)\n          && request.resource.data.participants.size() == 2\n          && request.resource.data.keys().hasOnly([\n            'participants', 'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadFor'\n          ])\n        );\n      allow update: if isAdmin()\n        || (\n          participantIn(resource.data)\n          && request.resource.data.participants == resource.data.participants\n          && request.resource.data.diff(resource.data).changedKeys().hasOnly([\n            'lastMessage', 'lastMessageAt', 'updatedAt', 'unreadFor'\n          ])\n        );\n\r\n      match /Messages/{messageId} {\n        allow read: if isAdmin()\n          || participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);\n\n        allow create: if signedIn()\n          && request.resource.data.senderId == request.auth.uid\n          && request.resource.data.text is string\n          && request.resource.data.text.size() > 0\n          && request.resource.data.text.size() <= 1000\n          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'replyTo', 'readBy', 'attachment', 'location'])\n          && participantIn(getAfter(/databases/$(database)/documents/Chats/$(chatId)).data);\n        allow update, delete: if false;\n      }\n\n      match /Presence/{presenceUid} {\n        allow read: if isAdmin()\n          || participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);\n        allow create, update, delete: if signedIn()\n          && request.auth.uid == presenceUid\n          && participantIn(get(/databases/$(database)/documents/Chats/$(chatId)).data);\n      }\n    }\r\n\r\n    match /MercadoPagoWebhooks/{webhookId} {\n      allow read, write: if false;\n    }\n\n    match /AuditLogs/{logId} {\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    match /PublicConfig/{configId} {\n      allow read: if signedIn();\n      allow write: if isAdmin();\n    }\n\n    match /RateLimits/{limitId} {\n      allow read, write: if false;\n    }\n\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-07-04T17:51:58.027247Z","metadata":{"services":["cloud.firestore"]}}
